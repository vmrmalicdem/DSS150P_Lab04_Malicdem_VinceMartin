# secrets / environment
.env
*.pem
*.key

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# raw source data is never committed (see metadata/source_manifest.yml)
data/source/*
!data/source/.gitkeep
!data/source/README.md

# generated data layers
data/raw/*
data/staging/*
data/curated/*
data/partitioned/*
data/quarantine/*
!data/**/.gitkeep

# runtime state and outputs
state/*
!state/.gitkeep
!state/ingest_checkpoint.json
!state/runs/
outputs/model/*
!outputs/model/.gitkeep
logs/
